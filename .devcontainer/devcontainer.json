	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [3000],

	// Use 'portsAttributes' to configure the behavior of forwarded ports.
	// The example below will open a browser when the port 3000 is forwarded.
	// "portsAttributes": {
	// 	"3000": {
	// 	  "label": "Dev Server",
	// 	  "onAutoForward": "openBrowser"
	// 	},
	// 	// Services running along side the devcontainer, like databases, etc.
	// 	// Can be defined in docker-compose.yml
	// 	"5432": {
	// 	  "label": "Postgres"
	// 	}
	// },

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add extensions to the container by clicking the settings gear
			// on the Extension's Page, and selecting "Add to Dev Container".
			// More info: https://code.visualstudio.com/docs/devcontainers/tutorial#_how-it-works
			"extensions": [
				"ms-python.python",
				// "ms-vscode.vscode-node-azure-pack",
				"ms-azuretools.vscode-docker",
				"ms-vscode-remote.remote-containers",
				"github.vscode-github-actions",
				"GitHub.copilot",
				"eamodio.gitlens",
				// "golang.go",
				"ms-toolsai.jupyter",
				"esbenp.prettier-vscode"
			]
		}
	},

	// Non-root user created for development. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode",

	// Uncomment to use specific mount points
	//
	// Can MASSIVELY improve performance on binary files, but should not be used for source code.
	//
	// More info: https://code.visualstudio.com/remote/advancedcontainers/improve-performance
	// "mounts": [
	//  // NodeJS
	// 	"source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
	//
	//	// NextJS
	// 	"source=${localWorkspaceFolderBasename}-nextjs,target=${containerWorkspaceFolder}/.next,type=volume"
	//
	//  // Python
	// 	"source=${localWorkspaceFolderBasename}-pycache,target=${containerWorkspaceFolder}/__pycache__,type=volume"
	// ],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt"
}
